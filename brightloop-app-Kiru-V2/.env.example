# Neon PostgreSQL
DATABASE_URL=postgres://user:password@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgres://user:password@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=replace-with-32-plus-char-random-string

# Cron protection
CRON_SECRET=replace-with-24-plus-char-random-string

# App
APP_URL=https://your-app.vercel.app

# Email (Nodemailer + Brevo SMTP) — if unset, reset links are logged to the
# console instead of emailed (only outside production; production logs an
# error and does not pretend the email was sent).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=noreply@brightloop.demo

# Demo account seeding (npm run db:seed) — optional; a random password is
# generated and printed once if these are omitted.
ADMIN_EMAIL=admin.brightloopoddohack@gmail.com
ADMIN_PASSWORD=
STAFF_EMAIL=staff.brightloopoddohack@gmail.com
STAFF_PASSWORD=
CUSTOMER_EMAIL=customer.brightloopoddohack@gmail.com
CUSTOMER_PASSWORD=

# One-click demo login on /login (POST /api/auth/demo-login). Resolves the
# ADMIN_EMAIL/STAFF_EMAIL/CUSTOMER_EMAIL account above server-side — no
# password is ever sent to the client. Leave unset/false to disable.
DEMO_LOGIN_ENABLED=true
