# Neon PostgreSQL
DATABASE_URL=postgres://user:password@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgres://user:password@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=replace-with-32-plus-char-random-string

# Cron protection
CRON_SECRET=replace-with-24-plus-char-random-string

# App
APP_URL=https://your-app.vercel.app

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# (optional) From address for email
RESEND_FROM=noreply@brightloop.demo
